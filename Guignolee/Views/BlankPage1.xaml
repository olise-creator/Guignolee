<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Guignolee.Views.BlankPage1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Guignolee.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="59" />
            <RowDefinition Height="59" />
            <RowDefinition Height="59" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBox
                Header="Donateur"
        PlaceholderText="Prénom Nom"
        Text="{x:Bind ViewModel.DonSelectionne.Donateur,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBox
        Header="Contenu du don"
        PlaceholderText="Ex. : Conserves de soupe"
        Text="{x:Bind ViewModel.DonSelectionne.Contenu,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBox
        Header="Quantité"
        MaxLength="3"
        PlaceholderText="Ex. : 24"
        Text="{x:Bind ViewModel.DonSelectionne.Quantite,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <CheckBox
    Grid.Row="3"
    Margin="0,28,0,0"
    
    Content="Périssable"
    IsChecked="False" />

        <Button
    Grid.Row="4"
    Margin="0,28,0,0"
    VerticalAlignment="Top"
    Click="btnModifier_Click"
    Background="Black"
    Content="Modifier"
    Foreground="White" />
    </Grid>
</Page>
