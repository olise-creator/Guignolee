<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Guignolee.Views.BlankPage1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Guignolee.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="55" />
            <RowDefinition Height="59" />
            <RowDefinition Height="59" />
            <RowDefinition Height="59" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <!--
                TODO: Ce n'est pas le bon modèle de vue (devrait être ModifierDonViewModel) et donc pas les bons champs
                ModifierDonViewModel contient la propriété DonEdit, c'est cet objet qui est lié à ce formulaire.
                
                Text="{x:Bind ViewModel.DonEdit.Donateur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            -->
            <TextBox
                Header="Donateur"
                PlaceholderText="Prénom Nom"
                Text="{x:Bind ViewModel.DonSelectionne.Donateur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBox
                Header="Contenu du don"
                PlaceholderText="Ex. : Conserves de soupe"
                Text="{x:Bind ViewModel.DonSelectionne.Contenu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBox
                Header="Quantité"
                MaxLength="3"
                PlaceholderText="Ex. : 24"
                Text="{x:Bind ViewModel.DonSelectionne.Quantite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <CheckBox
            Grid.Row="3"
            Margin="0,28,0,0"
            Content="Périssable"
            IsChecked="False" />

        <Button
            Grid.Row="4"
            Margin="0,28,0,0"
            VerticalAlignment="Top"
            Background="Black"
            Click="btnModifier_Click"
            Content="Modifier"
            Foreground="White" />
    </Grid>
</Page>
