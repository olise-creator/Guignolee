<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Guignolee.Views.RegistrePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Guignolee.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Guignolee.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer>

        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  En-tête : Logo et titre  -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="Pink" BorderThickness="1">
                    <Image
                        Grid.Column="0"
                        Width="72"
                        Height="72"
                        AutomationProperties.Name="Illustration : une boîte de dons avec un ruban"
                        Source="ms-appx:///Assets/Images/geralt-christmas-9185561.jpg" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="Registre des dons"
                        TextWrapping="Wrap" />
                    <TextBlock Text="Guignolée du cégep" />
                </StackPanel>
            </Grid>

            <TextBlock
                Grid.Row="1"
                FontSize="16"
                Text="{x:Bind ViewModel.EtatDons, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Liste des dons à remettre  -->
            <Border
                Grid.Row="2"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <Border
                        Padding="16,10"
                        Background="#FDE7D9"
                        CornerRadius="8,8,0,0">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#7A3300"
                            Text="Dons à remettre"
                            TextWrapping="Wrap" />
                    </Border>
                    <ListView
                        Height="320"
                        Margin="0,8"
                        AutomationProperties.Name="Dons à remettre"
                        ItemsSource="{x:Bind ViewModel.Dons, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.DonSelectionne, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:DonViewModel">
                                <StackPanel Padding="0,8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Contenu, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#555555"
                                        Text="{x:Bind Details, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!--  Actions sur le don sélectionné  -->
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="10">
                <Button Click="btnModifier_Click" Content="Modifier…" />
                <Button
                    Background="#A4262C"
                    Click="btnMarquerRemis_Click"
                    Content="Marquer comme remis"
                    Foreground="White" 
                    />
            </StackPanel>

            <!--  Formulaire d'ajout  -->
            <Border
                Grid.Row="4"
                Padding="16"
                Background="White"
                BorderBrush="#A4262C"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="12">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Nouveau don" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBox
                                Header="Donateur"
                                PlaceholderText="Prénom Nom"
                                Text="{x:Bind ViewModel.NouveauDon.Donateur,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBox
                                Header="Contenu du don"
                                PlaceholderText="Ex. : Conserves de soupe"
                                Text="{x:Bind ViewModel.NouveauDon.Contenu,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBox
                                Header="Quantité"
                                MaxLength="3"
                                PlaceholderText="Ex. : 24"
                                Text="{x:Bind ViewModel.NouveauDon.Quantite,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="3"
                            Margin="0,28,0,0"
                            VerticalAlignment="Top"
                            Content="Périssable"
                            IsChecked="False" 
                            
                            />

                        <Button
                            Grid.Column="4"
                            Margin="0,28,0,0"
                            VerticalAlignment="Top"
                            Background="#A4262C"
                            Click="btnAjouter_Click"
                            Content="Ajouter"
                            Foreground="White" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
